{
	"name": "github-assignments",
	"version": "1.1.0",
	"description": "Lightweight plugin to append assigned GitHub issues and pull requests to your note.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^4.1.7",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
